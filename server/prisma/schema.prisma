generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                String             @id @default(uuid())
  email             String             @unique
  name              String
  passwordHash      String
  quilttProfileId   String?            // Quiltt profile ID for this user
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  subscriptions     Subscription[]
  chatSessions      ChatSession[]
  quilttConnections QuilttConnection[]
}

model ChatSession {
  id        String        @id @default(uuid())
  title     String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  ChatMessage[]
}

model ChatMessage {
  id        String      @id @default(uuid())
  role      String      // "user" | "assistant"
  content   String
  createdAt DateTime    @default(now())

  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model Subscription {
  id               String    @id @default(uuid())
  name             String
  price            Float
  currency         String    @default("USD")

  billingCycle     String    @default("monthly") // weekly | monthly | quarterly | yearly
  billingCycleDay  Int?      // day of month the charge typically lands

  startDate        DateTime  @default(now()) // date of first detected/entered transaction
  lastBillingDate  DateTime? // date of most recent charge
  nextBillingDate  DateTime? // computed: lastBillingDate + billingCycle

  category         String?
  status           String    @default("active") // active | paused | cancelled
  logo             String?
  color            String?

  // Quiltt linkage
  transactionId    String?   // ID of the last matched Quiltt transaction
  detectionSource  String    @default("manual") // "quiltt" | "manual"
  connectionId     String?
  connection       QuilttConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)

  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model QuilttConnection {
  id              String    @id @default(uuid())
  quilttId        String    @unique  // Quiltt's internal connection ID
  institutionName String?
  lastSyncedAt    DateTime?

  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  subscriptions   Subscription[]
}
